# Free keys: console.groq.com and aistudio.google.com
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional. Without these, Dwarpal keeps pins, the audit log and the cache in memory.
DATABASE_URL=        # Postgres with pgvector, e.g. a free Neon database
REDIS_URL=           # e.g. a free Upstash Redis database

# Comma-separated origins allowed to call the API (the playground's URL)
DWARPAL_CORS_ORIGINS=http://localhost:5173
